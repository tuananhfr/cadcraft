{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "commandId",
    "version",
    "labelKey",
    "defaultAliases",
    "contexts",
    "capabilities",
    "undoable",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "labelKey": {
      "type": "string",
      "minLength": 1
    },
    "defaultAliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "model",
          "paper"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "undoable": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "unsupported"
      ]
    }
  }
}
