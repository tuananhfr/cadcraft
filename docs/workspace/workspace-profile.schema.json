{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadcraft.dev/schemas/workspace-profile/3.json",
  "title": "CADCraft workspace profile",
  "description": "Schema 3 wire format. Only schema field names use camelCase; enum values use snake_case. User-data keys and unknown fields are preserved verbatim. Profiles omit device geometry. The reader also accepts legacy snake_case schema 1.x profiles and sets. Import limits: 256 KiB, 32 nesting levels, 500 array elements, 1024 characters per string.",
  "type": "object",
  "properties": {
    "schemaVersion": {"const": 3, "description": "Version of this schema."},
    "profileId": {"type": "string", "maxLength": 1024, "description": "Stable id; presets use preset.<PRESET_ID>."},
    "tenantId": {"type": ["string", "null"], "maxLength": 1024},
    "scope": {
      "enum": ["platform", "product", "tenant", "company", "discipline", "project", "user", "session"],
      "description": "Layer of the merge order, most general first."
    },
    "ownerId": {"type": ["string", "null"], "maxLength": 1024},
    "name": {"type": "string", "maxLength": 1024},
    "baseId": {"type": ["string", "null"], "maxLength": 1024, "description": "Preset or profile this one derives from."},
    "revision": {"type": "integer", "minimum": 0},
    "etag": {"type": ["string", "null"], "maxLength": 1024, "description": "Opaque server version tag."},
    "status": {"enum": ["draft", "published"]},
    "locale": {"type": ["string", "null"], "maxLength": 1024},
    "theme": {"type": ["string", "null"], "maxLength": 1024},
    "createdAt": {"type": "string", "format": "date-time", "maxLength": 1024},
    "updatedAt": {"type": "string", "format": "date-time", "maxLength": 1024},
    "layout": {"$ref": "#/$defs/layout"},
    "layoutPatch": {"$ref": "#/$defs/layout", "description": "Stored user layer over the base preset and policy; geometry belongs to deviceGeometry."},
    "checksum": {"type": "string", "description": "sha256: plus lowercase hex of canonical JSON excluding the top-level checksum field."}
  },
  "additionalProperties": true,
  "$defs": {
    "ratio": {"type": "number", "minimum": 0, "maximum": 1, "description": "Fraction of the content area; out-of-range values are clamped when read."},
    "commandId": {"type": "string", "maxLength": 1024, "description": "Engine or UI command id. Unknown ids are kept and shown as unavailable placeholders."},
    "dock": {"enum": ["top", "bottom", "left", "right", "floating"]},
    "layout": {
      "type": "object",
      "properties": {
        "ribbon": {"$ref": "#/$defs/ribbon"},
        "toolbars": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/toolbar"}},
        "panels": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/panel"}},
        "dockTree": {"type": ["object", "null"], "description": "craft-ui dock layout, opaque outside the code that applies it."},
        "commandLine": {"$ref": "#/$defs/commandLine"},
        "quickAccess": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/commandId"}},
        "statusBar": {"$ref": "#/$defs/statusBar"},
        "shortcuts": {
          "type": "object",
          "description": "Command id to key chord, for example \"Ctrl+Shift+L\".",
          "additionalProperties": {"type": "string", "maxLength": 1024}
        },
        "aliases": {"type": "object", "description": "Command-line alias to command id.", "additionalProperties": {"$ref": "#/$defs/commandId"}},
        "favorites": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/commandId"}},
        "toolsets": {"$ref": "#/$defs/toolSets"},
        "view": {"$ref": "#/$defs/view"},
        "quickAccessPosition": {"enum": ["title_bar", "above_ribbon", "below_ribbon"], "default": "title_bar", "description": "Where the Quick Access toolbar sits. title_bar falls back to its own row above the ribbon while the menu bar is in the window."},
        "density": {"enum": ["compact", "normal", "comfortable"], "default": "normal", "description": "Interface density: control sizes and spacing. comfortable makes every ribbon, Quick Access, toolbar and file-tab button at least 32 points."}
      },
      "additionalProperties": true
    },
    "ribbon": {
      "type": "object",
      "properties": {
        "visible": {"type": "boolean"},
        "collapsed": {"type": "boolean"},
        "tabs": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/ribbonTab"}},
        "ribbonMode": {"enum": ["expanded", "compact", "tabs_only", "hidden", null], "description": "When absent or null, uses visible/collapsed legacy flags. Enum values keep snake_case."}
      }
    },
    "ribbonTab": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 1024},
        "label": {"type": "string", "maxLength": 1024},
        "order": {"type": "integer", "minimum": 0},
        "visible": {"type": "boolean"},
        "contextual": {
          "type": ["string", "null"],
          "maxLength": 1024,
          "description": "Selection kind that shows the tab (dimension, hatch); null for a standing tab."
        },
        "groups": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/ribbonGroup"}}
      }
    },
    "ribbonGroup": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 1024},
        "label": {"type": "string", "maxLength": 1024},
        "commands": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/commandId"}}
      }
    },
    "toolbar": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 1024},
        "label": {"type": "string", "maxLength": 1024},
        "dock": {"$ref": "#/$defs/dock"},
        "order": {"type": "integer", "minimum": 0},
        "row": {"type": "integer", "minimum": 0},
        "visible": {"type": "boolean"},
        "locked": {"type": "boolean"},
        "xRatio": {"$ref": "#/$defs/ratio"},
        "yRatio": {"$ref": "#/$defs/ratio"},
        "commands": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/commandId"}}
      }
    },
    "panel": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 1024, "description": "Panel id, for example properties, layers, toolSets."},
        "mode": {"enum": ["dock", "float", "auto_hide", "hidden"]},
        "side": {"oneOf": [{"$ref": "#/$defs/dock"}, {"type": "null"}]},
        "tabGroup": {"type": ["string", "null"], "maxLength": 1024},
        "visible": {"type": "boolean"},
        "xRatio": {"$ref": "#/$defs/ratio"},
        "yRatio": {"$ref": "#/$defs/ratio"},
        "widthRatio": {"$ref": "#/$defs/ratio"},
        "heightRatio": {"$ref": "#/$defs/ratio"}
      }
    },
    "commandLine": {
      "type": "object",
      "properties": {
        "dock": {"enum": ["top", "bottom", "floating"], "description": "Also accepted as `side`; left and right are read as bottom."},
        "heightRatio": {"$ref": "#/$defs/ratio"},
        "lines": {"type": "integer", "minimum": 0},
        "visible": {"type": "boolean"},
        "xRatio": {"$ref": "#/$defs/ratio"},
        "yRatio": {"$ref": "#/$defs/ratio"}
      }
    },
    "statusBar": {
      "type": "object",
      "properties": {
        "visible": {"type": "boolean"},
        "items": {"type": "object", "description": "Status bar toggle name to shown.", "additionalProperties": {"type": "boolean"}}
      }
    },
    "toolSets": {
      "type": "object",
      "properties": {
        "visible": {"type": "boolean"},
        "tab": {"type": "string", "maxLength": 1024},
        "collapsedGroups": {"type": "array", "maxItems": 500, "items": {"type": "string", "maxLength": 1024}},
        "hiddenTools": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/commandId"}}
      }
    },
    "view": {
      "type": "object",
      "description": "Show/hide switches for parts of the window that are not panels or tool bars.",
      "properties": {
        "fileTabs": {"type": "boolean"},
        "viewcube": {"type": "boolean"},
        "ucsIcon": {"type": "boolean"},
        "layerList": {"type": "boolean", "description": "The layer list under the Layers palette's header."},
        "propertiesAll": {"type": "boolean", "description": "Properties shows every property rather than the common ones."},
        "inWindowMenu": {"type": "boolean", "description": "In-window menu bar; defaults to off on macOS, on elsewhere."}
      }
    },
    "screen": {
      "type": "object",
      "properties": {
        "monitorCount": {"type": "integer"},
        "workArea": {"type": "array", "items": {"type": "number"}},
        "pixelRatio": {"type": "number"},
        "windowMode": {"type": "string"}
      },
      "additionalProperties": true
    },
    "device": {
      "type": "object",
      "properties": {
        "uiScale": {"type": "number", "minimum": 0.75, "maximum": 2.0},
        "screen": {"oneOf": [{"$ref": "#/$defs/screen"}, {"type": "null"}]},
        "layoutPatch": {"$ref": "#/$defs/layout"}
      },
      "additionalProperties": true
    },
    "profileSet": {
      "type": "object",
      "properties": {
        "schemaVersion": {"const": 3},
        "active": {"type": "string"},
        "profiles": {"type": "array", "maxItems": 20, "items": {"$ref": "#"}},
        "user": {"oneOf": [{"$ref": "#"}, {"type": "null"}]},
        "deviceGeometry": {"oneOf": [{"$ref": "#/$defs/device"}, {"type": "null"}]},
        "checksum": {"type": "string", "description": "sha256: plus lowercase hex of canonical JSON excluding the top-level checksum field."}
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"level": {"type": "string"}, "patch": {"$ref": "#/$defs/layout"}, "locks": {"type": "array", "items": {"type": "string"}}}
          }
        }
      }
    }
  }
}
